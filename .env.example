# .env.example
MONGODB_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
STUDIO_EMAIL=
SITE_URL=https://example.com
# Optionnel : ton domaine final (sans https). Laisse vide pour accepter seulement localhost et les domaines Vercel du déploiement.
ALLOWED_HOSTS=
SAME_AS=
# Optionnel : sinon la signature de session est dérivée du mot de passe admin
SESSION_SECRET=
# Compte admin unique (mot de passe en clair : choisis-en un long ; les variables Vercel restent privées)
ADMIN_USERNAME=
ADMIN_PASSWORD=
CRON_SECRET=

# Coordonnées affichées sur le site (page Contact + pied de page)
STUDIO_PHONE=
STUDIO_WHATSAPP=
# Google Search Console (balise de vérification, optionnel)
GOOGLE_SITE_VERIFICATION=
